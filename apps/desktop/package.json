  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "defuddle": "^0.19.4",
    "dompurify": "^3.2.0",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/markdown-it": "^14.1.2",
    "typescript": "^5.9.0",
    "vite": "^8.3.1"
  }
}
